[Unit]
Description=eve Discord starter gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/eve-discord-starter
Environment=PATH=/home/YOUR_USER/.nvm/versions/node/v24.x.x/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/YOUR_USER/.nvm/versions/node/v24.x.x/bin/pnpm gateway
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
